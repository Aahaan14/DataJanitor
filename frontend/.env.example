# Frontend settings (these are PUBLIC — never put secrets here).
# Leave empty in development: the Vite dev server proxies /api to the backend.
# Set it when the API lives on another origin, e.g. https://api.example.com
# (and add this site's origin to CORS_ORIGINS in the backend .env).
VITE_API_BASE_URL=

# Optional: where the dev proxy forwards API calls (default http://127.0.0.1:8000)
# VITE_DEV_BACKEND=http://127.0.0.1:8000
