# =============================================================================
# DataJanitor — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=DataJanitor
APP_ENV=development
DEBUG=false

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
CLEANED_DIR=cleaned
MAX_ROWS=100000
MAX_COLUMNS=200
PREVIEW_ROWS=10
MAX_ISSUES_RETURNED=5000
MAX_PROPOSALS_PER_PLAN=20000

# --- Database ---
DATABASE_URL=sqlite:///./datajanitor.db

# --- Retention ---
UPLOAD_RETENTION_DAYS=30
ORPHAN_GRACE_HOURS=24
CLEANED_RETENTION_DAYS=7

# --- Email reports (Phase 7) ---
# Nothing is sent unless EMAIL_REPORTS_ENABLED=true and the SMTP values below are set.
# Use an app password, never your normal account password. Never commit .env.
EMAIL_REPORTS_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl (port 465) | none (localhost only)
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com
# REPORT_RECIPIENT=recipient@example.com
# SMTP_TIMEOUT_SECONDS=10
# REPORT_INCLUDE_NAMES=true     # false = leave file and column names out of emails

# --- CORS (Phase 8+) ---
CORS_ORIGINS=http://localhost:5173
